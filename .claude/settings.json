{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/plugin-dev/version-guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ddaa@ddaanet": true,
    "gitlore@ddaanet": true
  },
  "gitlore": {
    "enabled": true,
    "precommitCommand": "just precommit"
  }
}
